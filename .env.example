# Copy this file to .env only when you need to override local Docker Compose defaults.
DB_NAME=treasureverse
DB_USERNAME=treasureverse
DB_PASSWORD=treasureverse
MARIADB_ROOT_PASSWORD=root
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=treasureverse-local
# Use a randomly generated value before sharing the environment with anyone.
JWT_SECRET=treasureverse-local-development-secret-key-change-me-1234567890
